.login-page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 60rpx;
  position: relative;
}

.login-hero {
  position: relative;
  overflow: hidden;
  padding: 72rpx 52rpx 150rpx;
  background: linear-gradient(145deg, #0e2a68 0%, #234fc4 55%, #3d6ef7 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.login-hero::before {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -130rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.login-hero::after {
  content: '';
  position: absolute;
  left: -90rpx;
  bottom: -140rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.login-brand {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.35;
}

.login-brand-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.login-card {
  position: relative;
  z-index: 2;
  margin: -92rpx 32rpx 0;
  padding: 44rpx 36rpx 34rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 48rpx rgba(20, 48, 110, 0.12);
}

.login-card-title {
  color: #16233b;
  font-size: 38rpx;
  font-weight: 700;
}

.login-form-item {
  margin-top: 34rpx;
}

.login-label {
  color: #3f4a5c;
  font-size: 26rpx;
  font-weight: 600;
}

.login-input {
  height: 92rpx;
  margin-top: 14rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: #f7f9fd;
  border: 2rpx solid #edf1f8;
  color: #1f2937;
  font-size: 30rpx;
}

.login-placeholder {
  color: #b6bdc9;
}

.login-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 40rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #3d6ef7, #6b8dff);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx rgba(61, 110, 247, 0.26);
}

.login-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx rgba(7, 193, 96, 0.22);
}

.login-wechat::after {
  border: none;
}

.login-wechat.is-disabled {
  opacity: 0.62;
  box-shadow: none;
}

.login-submit::after {
  border: none;
}

.login-submit.is-disabled {
  opacity: 0.62;
  box-shadow: none;
}

.login-foot {
  margin-top: 50rpx;
  color: #b6bdc9;
  font-size: 22rpx;
  text-align: center;
}

.login-checking {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fb;
}

.login-checking-box {
  padding: 22rpx 34rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(19, 42, 92, 0.08);
}
