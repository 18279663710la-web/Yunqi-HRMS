<view class="login-page">
  <view class="login-hero">
    <view class="login-brand">广东省优科印刷材料有限公司</view>
    <view class="login-brand-sub">企业办公 · 员工登录</view>
  </view>

  <view class="login-card">
    <view class="login-card-title">账号登录</view>

    <view class="login-form-item">
      <view class="login-label">登录名</view>
      <input
        class="login-input"
        value="{{loginName}}"
        placeholder="请输入登录名"
        placeholder-class="login-placeholder"
        maxlength="50"
        bindinput="onLoginNameInput"
      />
    </view>

    <view class="login-form-item">
      <view class="login-label">密码</view>
      <input
        class="login-input"
        password="{{true}}"
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-class="login-placeholder"
        maxlength="64"
        confirm-type="done"
        bindinput="onPasswordInput"
        bindconfirm="onSubmit"
      />
    </view>

    <button
      class="login-submit {{loading || checking ? 'is-disabled' : ''}}"
      loading="{{loading}}"
      disabled="{{loading || checking}}"
      bindtap="onSubmit"
    >
      登录
    </button>

    <view class="login-wx" wx:if="{{wxConfigured}}" bindtap="onWechatLogin">
      <image class="login-wx-icon" src="/assets/wx-login-icon.png" mode="aspectFit" />
      <view class="login-wx-label">微信登录</view>
    </view>

  </view>

  <view class="login-foot" bindlongpress="onServerSetting">云启科技 · 企业办公</view>

  <view class="wx-consent" wx:if="{{consentVisible}}">
    <view class="wx-consent-app">
      <view class="login-brand-mark">云</view>
      <view class="wx-consent-app-name">云枢办公</view>
      <view class="wx-consent-apply">申请获得</view>
    </view>
    <view class="wx-consent-title">以下权限</view>
    <view class="wx-consent-item">
      <view class="wx-consent-check"></view>
      <view class="wx-consent-text">获取你的微信登录身份，用于绑定员工账号免密登录</view>
    </view>
    <view class="wx-consent-bottom">
      <button class="wx-consent-agree {{wechatLoading ? 'is-disabled' : ''}}" loading="{{wechatLoading}}" disabled="{{wechatLoading}}" bindtap="onConsentAgree">同 意</button>
      <view class="wx-consent-cancel" bindtap="onConsentCancel">取消</view>
    </view>
  </view>

  <view class="login-checking" wx:if="{{checking}}">
    <view class="login-checking-box">正在检查登录状态…</view>
  </view>
</view>
