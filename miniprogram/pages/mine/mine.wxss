.menu-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #1A1D26;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9AA1AC;
}

/* ============ 底部信息 ============ */
.mine-foot {
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mine-foot-name {
  font-size: 26rpx;
  color: #9AA1AC;
}

.mine-foot-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #C4CAD6;
}
