/* ============ 个人信息头 ============ */
.mine-hero {
  padding: 40rpx 40rpx 100rpx;
  background: linear-gradient(160deg, #3D6EF7 0%, #5B8DFF 62%, #7BA0FF 100%);
  border-radius: 0 0 44rpx 44rpx;
}

.mine-user {
  display: flex;
  align-items: center;
}

.mine-avatar {
  background: rgba(255, 255, 255, 0.26);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

.mine-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.mine-name {
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.mine-position {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.88);
}

.mine-dept {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.68);
}

.mine-meta {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
}

.mine-meta-item {
  height: 46rpx;
  padding: 0 18rpx;
  margin-right: 14rpx;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 21rpx;
  line-height: 46rpx;
}

.page-body {
  margin-top: -64rpx;
}

/* ============ 统计卡 ============ */
.stat-card {
  display: flex;
  padding: 32rpx 0;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-cell-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1D26;
  line-height: 1.15;
}

.c-blue {
  color: #3D6EF7;
}

.c-orange {
  color: #F79009;
}

.stat-cell-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9AA1AC;
}

/* ============ 考勤概览 ============ */
.att-summary {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
}

.att-summary-left {
  flex: 1;
  min-width: 0;
}

.att-summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1D26;
}

.att-summary-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9AA1AC;
}

/* ============ 菜单 ============ */
.menu-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  min-height: 108rpx;
}

.menu-row + .menu-row {
  border-top: 2rpx solid #F2F4F8;
}

.menu-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background-color: #EAF0FF;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 34rpx 34rpx;
}

.menu-icon.is-danger {
  background-color: #FFEDEC;
}

