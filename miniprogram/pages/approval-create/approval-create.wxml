<view class="page">
  <view class="page-body has-bottom-bar">
    <!-- ============ 类型选择 ============ -->
    <view class="section-head">
      <view class="section-title">审批类型</view>
    </view>

    <view class="card type-card">
      <scroll-view class="type-scroll" scroll-x="{{true}}" enable-flex="{{true}}">
        <view class="type-track">
          <view
            class="type-cell {{typeKey === item.key ? 'active' : ''}}"
            wx:for="{{types}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onTypeTap"
            hover-class="type-cell-hover"
            hover-stay-time="60"
          >
            <view class="type-cell-icon" style="background-color: {{item.color}}">
              <image wx:if="{{item.key === 'leave'}}" class="type-icon" src="/assets/approvals/leave.png" mode="aspectFit" />
              <image wx:elif="{{item.key === 'expense'}}" class="type-icon" src="/assets/approvals/expense.png" mode="aspectFit" />
              <image wx:elif="{{item.key === 'overtime'}}" class="type-icon" src="/assets/approvals/overtime.png" mode="aspectFit" />
              <image wx:elif="{{item.key === 'travel'}}" class="type-icon" src="/assets/approvals/travel.png" mode="aspectFit" />
              <image wx:elif="{{item.key === 'purchase'}}" class="type-icon" src="/assets/approvals/purchase.png" mode="aspectFit" />
              <image wx:else class="type-icon" src="/assets/approvals/custom.png" mode="aspectFit" />
            </view>
            <view class="type-cell-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============ 动态表单 ============ -->
    <view class="section-head">
      <view class="section-title">申请内容</view>
    </view>

    <block wx:for="{{segments}}" wx:for-item="segment" wx:key="key">
      <view class="card" wx:if="{{segment.kind === 'fields'}}">
        <view class="form-row {{field.type === 'textarea' ? 'is-block' : ''}}" wx:for="{{segment.fields}}" wx:for-item="field" wx:key="key">
          <view class="form-label">
            <text class="form-req" wx:if="{{field.required}}">*</text>{{field.label}}
          </view>

          <view class="form-control">
            <view wx:if="{{typeKey === 'leave' && field.key === 'days'}}" class="picker-value">
              {{values[field.key] || '请选择有效起止时间'}}
            </view>

            <input
              wx:elif="{{field.type === 'text' || field.type === 'number' || field.type === 'money'}}"
              class="form-input"
              type="{{field.type === 'number' || field.type === 'money' ? 'digit' : 'text'}}"
              value="{{values[field.key]}}"
              placeholder="{{field.placeholder || '请输入'}}"
              placeholder-class="form-placeholder"
              data-key="{{field.key}}"
              bindinput="onInput"
            />

            <picker
              wx:elif="{{field.type === 'picker'}}"
              mode="selector"
              range="{{field.options}}"
              data-key="{{field.key}}"
              bindchange="onPicker"
            >
              <view class="picker-value {{values[field.key] ? '' : 'is-placeholder'}}">
                {{values[field.key] || '请选择'}}
                <view class="picker-arrow"></view>
              </view>
            </picker>

            <picker
              wx:elif="{{field.type === 'date'}}"
              mode="date"
              value="{{values[field.key]}}"
              data-key="{{field.key}}"
              bindchange="onPicker"
            >
              <view class="picker-value {{values[field.key] ? '' : 'is-placeholder'}}">
                {{values[field.key] || '请选择日期'}}
                <view class="picker-arrow"></view>
              </view>
            </picker>

            <picker
              wx:elif="{{field.type === 'time'}}"
              mode="time"
              value="{{values[field.key]}}"
              data-key="{{field.key}}"
              bindchange="onPicker"
            >
              <view class="picker-value {{values[field.key] ? '' : 'is-placeholder'}}">
                {{values[field.key] || '请选择时间'}}
                <view class="picker-arrow"></view>
              </view>
            </picker>

            <textarea
              wx:elif="{{field.type === 'textarea'}}"
              class="form-textarea"
              value="{{values[field.key]}}"
              placeholder="{{field.placeholder || '请输入'}}"
              placeholder-class="form-placeholder"
              maxlength="{{field.maxlength || 200}}"
              data-key="{{field.key}}"
              bindinput="onInput"
            />
          </view>
        </view>
      </view>

      <block wx:elif="{{segment.kind === 'invoice'}}">
        <view class="section-head">
          <view class="section-title">发票附件</view>
        </view>
        <invoice-uploader id="invoiceUploader" max="{{9}}" check-duplicate="{{expenseCheckDuplicate}}" verify-invoice="{{expenseCheckVerify}}" bind:change="onInvoiceChange" />
        <view class="form-tip" wx:if="{{!invoiceCheckReady}}">{{invoiceCheckMessage}}</view>
      </block>

      <block wx:elif="{{segment.kind === 'materials'}}">
        <view class="section-head"><view class="section-title">补充材料</view></view>
        <view class="card">
          <view class="attachment-row" wx:for="{{attachments}}" wx:for-item="file" wx:key="fileID">
            <image class="attachment-thumb" src="{{file.preview}}" mode="aspectFill" />
            <input class="attachment-name" value="{{file.name}}" placeholder="材料名称" maxlength="100" data-index="{{index}}" bindinput="onAttachmentName" />
            <view class="attachment-remove" data-index="{{index}}" bindtap="removeAttachment">删除</view>
          </view>
          <view class="attachment-add" bindtap="addAttachments">{{uploadingAttachments ? '上传中…' : '添加材料图片'}}</view>
        </view>
      </block>

      <block wx:elif="{{segment.kind === 'files'}}">
        <view class="section-head"><view class="section-title"><text class="form-req" wx:if="{{segment.required}}">*</text>{{segment.title}}</view></view>
        <view class="card">
          <view class="attachment-row" wx:for="{{fieldFiles[segment.key]}}" wx:for-item="file" wx:key="fileID">
            <image class="attachment-thumb" src="{{file.preview}}" mode="aspectFill" />
            <input class="attachment-name" value="{{file.name}}" placeholder="附件名称" maxlength="100" data-key="{{segment.key}}" data-index="{{index}}" bindinput="onFieldFileName" />
            <view class="attachment-remove" data-key="{{segment.key}}" data-index="{{index}}" bindtap="removeFieldFile">删除</view>
          </view>
          <view class="attachment-add" data-key="{{segment.key}}" bindtap="addFieldFiles">{{uploadingFieldKey === segment.key ? '上传中…' : '添加附件图片'}}</view>
        </view>
      </block>
    </block>

    <!-- ============ 审批设置 ============ -->
    <view class="section-head">
      <view class="section-title">审批流转</view>
    </view>

    <view class="card card-tight">
      <view class="list-row" wx:for="{{approvers}}" wx:key="id">
        <view class="setting-label">审批人</view>
        <view class="flex-1"></view>
        <view class="approver-chip">
          <view class="avatar avatar-sm">{{item.name}}</view>
          <view class="approver-info">
            <view class="approver-name">{{item.name}}</view>
            <view class="approver-role">{{item.role}}</view>
          </view>
        </view>
      </view>
      <view class="list-row" wx:if="{{!approvers.length && approverHint}}">
        <view class="setting-label">审批人</view>
        <view class="flex-1"></view>
        <view class="approver-name">{{approverHint}}</view>
      </view>
      <view class="list-row">
        <view class="setting-label">加急处理</view>
        <view class="setting-hint">加急单据将在审批列表中置顶提醒</view>
        <view class="flex-1"></view>
        <switch checked="{{urgent}}" color="#3D6EF7" bindchange="onUrgentChange" />
      </view>
    </view>
  </view>

  <!-- ============ 底部提交栏 ============ -->
  <view class="fixed-bottom-bar">
    <view
      class="btn btn-primary flex-1 {{canSubmit && approverReady && !submitting && !recognizingInvoices && (typeKey !== 'expense' || invoiceCheckReady) ? '' : 'btn-disabled'}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中...' : recognizingInvoices ? '发票识别中...' : '提交审批'}}
    </view>
  </view>
</view>
