/* ============ 名片头 ============ */
.profile-hero {
  padding: 40rpx 40rpx 96rpx;
  background: linear-gradient(160deg, #3D6EF7 0%, #5B8DFF 62%, #7BA0FF 100%);
  border-radius: 0 0 44rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-avatar {
  background: rgba(255, 255, 255, 0.26);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
}

.profile-name {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: flex;
  align-items: center;
}

.profile-leader-tag {
  margin-left: 14rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.26);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.profile-position {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.profile-dept {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.profile-tags {
  margin-top: 24rpx;
  display: flex;
}

.profile-tag {
  height: 48rpx;
  padding: 0 20rpx;
  margin: 0 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 48rpx;
}

.page-body {
  margin-top: -60rpx;
}

.has-bottom-bar {
  padding-bottom: 200rpx;
}

/* ============ 信息行 ============ */
.info-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 0;
}

.info-row + .info-row {
  border-top: 2rpx solid #F2F4F8;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #9AA1AC;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1A1D26;
}

.info-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #EAF0FF;
  color: #3D6EF7;
  font-size: 22rpx;
  line-height: 48rpx;
}

/* ============ 汇报关系 ============ */
.emp-line {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.emp-line + .emp-line {
  border-top: 2rpx solid #F2F4F8;
}

.emp-line-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.emp-line-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1D26;
}

.emp-line-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9AA1AC;
}
