.onboarding-mask { position: fixed; inset: 0; z-index: 999; background: rgba(17, 27, 45, .58); display: flex; align-items: center; justify-content: center; padding: 28rpx; }
.onboarding-dialog { width: 100%; max-width: 680rpx; max-height: 90vh; overflow: hidden; background: #fff; border-radius: 24rpx; box-sizing: border-box; box-shadow: 0 18rpx 60rpx rgba(16, 32, 60, .18); }
.onboarding-header { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 30rpx 24rpx; border-bottom: 1rpx solid #edf1f7; }
.onboarding-header-icon { display: flex; flex: 0 0 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 18rpx; color: #3d6ef7; background: #edf3ff; font-size: 30rpx; font-weight: 600; }
.onboarding-header-copy { min-width: 0; }
.onboarding-heading { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.onboarding-header .onboarding-heading { margin: 0; color: #192840; font-size: 33rpx; line-height: 1.35; }
.onboarding-subtitle { margin-top: 5rpx; color: #78869a; font-size: 23rpx; line-height: 1.45; }
.onboarding-hint { padding: 38rpx 32rpx; color: #58677b; font-size: 28rpx; line-height: 1.7; }
.onboarding-fields { display: block; height: 58vh; max-height: 780rpx; padding: 24rpx 30rpx 8rpx; box-sizing: border-box; }
.onboarding-section-title { display: flex; align-items: center; gap: 10rpx; margin-bottom: 26rpx; color: #273b57; font-size: 27rpx; font-weight: 600; }
.onboarding-section-mark { width: 6rpx; height: 26rpx; border-radius: 4rpx; background: #3d6ef7; }
.onboarding-section-final { margin-top: 38rpx; padding-top: 28rpx; border-top: 1rpx solid #edf1f7; }
.onboarding-field { margin-bottom: 28rpx; font-size: 28rpx; }
.onboarding-field-label { margin-bottom: 12rpx; color: #2e3d54; font-size: 27rpx; font-weight: 500; line-height: 1.45; overflow-wrap: break-word; }
.onboarding-required { color: #e55b5b; }
.onboarding-optional { margin-left: 4rpx; color: #9aa6b6; font-size: 22rpx; font-weight: 400; }
.onboarding-input { display: block; width: 100%; height: 82rpx; min-height: 82rpx; margin: 0; padding: 0 22rpx; box-sizing: border-box; border: 1rpx solid #cdd6e4; border-radius: 12rpx; background: #fff; color: #24344d; font-size: 28rpx; line-height: normal; }
.onboarding-placeholder, .onboarding-date-placeholder { color: #a2adbd; }
.onboarding-date, .onboarding-select { display: flex; align-items: center; justify-content: space-between; }
.onboarding-date-arrow { color: #9aa9bc; font-size: 36rpx; line-height: 1; }
.onboarding-row { margin: 12rpx 0 16rpx; padding: 20rpx; border: 1rpx solid #dce5f2; border-radius: 16rpx; background: #f6f9fe; }
.onboarding-row-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.onboarding-row-index { color: #3a5274; font-size: 25rpx; font-weight: 600; }
.onboarding-row-remove { margin: 0; padding: 0 8rpx; color: #bd4b4b; background: transparent; font-size: 24rpx; line-height: 50rpx; }
.onboarding-cell { margin-top: 18rpx; }
.onboarding-cell-label { margin-bottom: 10rpx; color: #53657d; font-size: 25rpx; line-height: 1.45; }
.onboarding-add, .onboarding-action { margin: 0; padding: 0 22rpx; border: 1rpx solid #cbd9f5; border-radius: 10rpx; color: #315fca; background: #f6f9ff; font-size: 24rpx; font-weight: 500; line-height: 62rpx; }
.onboarding-add-icon { font-size: 27rpx; }
.onboarding-row-remove::after, .onboarding-add::after, .onboarding-action::after, .onboarding-submit::after { border: none; }
.onboarding-upload { display: flex; align-items: center; gap: 18rpx; padding: 20rpx; border: 1rpx solid #e1e8f2; border-radius: 14rpx; background: #f9fbfe; }
.onboarding-photo, .onboarding-photo-placeholder { display: flex; flex: 0 0 112rpx; width: 112rpx; height: 132rpx; margin: 0; border-radius: 10rpx; }
.onboarding-photo-placeholder { align-items: center; justify-content: center; color: #7c95be; background: #eaf0fa; font-size: 28rpx; }
.onboarding-upload-copy { min-width: 0; }
.onboarding-upload-title { color: #30425c; font-size: 25rpx; font-weight: 500; }
.onboarding-upload-hint { margin: 6rpx 0 12rpx; color: #8a98aa; font-size: 21rpx; line-height: 1.5; }
.onboarding-signature-preview { display: block; width: 300rpx; height: 150rpx; margin: 0 0 12rpx; background: #fff; border: 1rpx solid #dce5f2; border-radius: 10rpx; }
.onboarding-footer { padding: 20rpx 30rpx 28rpx; border-top: 1rpx solid #edf1f7; background: #fff; }
.onboarding-submit { width: 100%; margin: 0; border-radius: 12rpx; color: #fff; background: #3d6ef7; font-size: 29rpx; font-weight: 600; line-height: 84rpx; }
.onboarding-submit[disabled] { color: #d8e2f7; background: #9bb1e9; }
.onboarding-confirm { display: flex; align-items: center; color: #4c5f7b; font-size: 25rpx; }
.onboarding-signature-field { margin-bottom: 20rpx; }
@media (max-height: 600px) { .onboarding-fields { height: 50vh; } }
.onboarding-declaration { margin: 12rpx 0; color: #596579; line-height: 1.6; white-space: normal; }

page { background: #f5f7fb; }
.onboarding-page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.onboarding-header { flex: 0 0 auto; }
.onboarding-fields { height: 0; max-height: none; min-height: 0; flex: 1 1 auto; }
.onboarding-footer { flex: 0 0 auto; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.onboarding-status { padding: 56rpx 32rpx; color: #718096; text-align: center; line-height: 1.6; }
.onboarding-retry { margin-top: 24rpx; }
@media (max-height: 600px) { .onboarding-fields { height: 0; } }
.onboarding-attachments { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; }
.onboarding-attachment { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 14rpx 18rpx; box-sizing: border-box; background: #f5f7fb; border-radius: 12rpx; }
.onboarding-attachment-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 25rpx; color: #36465f; }
.onboarding-attachment-remove { margin: 0; padding: 0 14rpx; color: #e15454; background: transparent; font-size: 23rpx; }
.onboarding-attachment-remove::after { border: 0; }
.onboarding-attachment-hint { color: #929eae; font-size: 22rpx; }
