page { width: 100%; height: 100%; background: #f3f6fb; }
.signature-page { display: flex; flex-direction: column; width: 100%; height: 100vh; box-sizing: border-box; padding: 12px calc(20px + env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom)) calc(20px + env(safe-area-inset-left)); }
.signature-header { display: flex; align-items: baseline; gap: 12px; flex: none; padding: 0 2px 10px; }
.signature-title { color: #17243b; font-size: 18px; font-weight: 600; }
.signature-hint { color: #8290a4; font-size: 12px; }
.signature-paper { position: relative; flex: 1; min-height: 0; overflow: hidden; background: #fff; border: 1px solid #d9e2ef; border-radius: 10px; }
.signature-canvas { position: relative; z-index: 1; display: block; width: 100%; height: 100%; }
.signature-placeholder { position: absolute; top: 50%; left: 0; width: 100%; transform: translateY(-50%); text-align: center; color: #c7d1df; font-size: 16px; pointer-events: none; }
.signature-footer { display: flex; justify-content: flex-end; gap: 10px; flex: none; padding-top: 10px; }
.signature-button { min-width: 76px; margin: 0; padding: 0 18px; border-radius: 8px; font-size: 14px; line-height: 38px; }
.signature-button::after { border: none; }
.signature-cancel, .signature-clear { color: #4c5d75; background: #fff; border: 1px solid #dce4ef; }
.signature-save { min-width: 112px; color: #fff; background: #3d6ef7; }
.signature-save[disabled] { color: #d8e2f7; background: #9bb1e9; }
