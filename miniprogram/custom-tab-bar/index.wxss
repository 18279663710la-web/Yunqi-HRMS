.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  height: 104rpx;
  padding-top: 10rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -2rpx 20rpx rgba(24, 43, 92, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-item-hover {
  opacity: 0.7;
}

.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #8A94A6;
  transition: color 0.15s ease;
}

.tab-item.active .tab-text {
  color: #3D6EF7;
  font-weight: 600;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: #F04438;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(240, 68, 56, 0.4);
}

