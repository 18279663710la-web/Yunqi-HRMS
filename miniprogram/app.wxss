/**
 * app.wxss — 全局样式与设计令牌
 * 设计规范：圆角 24rpx / 卡片留白 32rpx / 主色 #3D6EF7
 */

page {
  --primary: #3D6EF7;
  --primary-dark: #2952D9;
  --primary-light: #EAF0FF;
  --bg: #F5F7FB;
  --card: #FFFFFF;
  --t1: #1A1D26;
  --t2: #5A6472;
  --t3: #9AA1AC;
  --line: #EEF1F6;
  --success: #16B364;
  --warning: #F79009;
  --danger: #F04438;
  --radius: 24rpx;

  background-color: #F5F7FB;
  color: #1A1D26;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

/* ---------- 布局骨架 ---------- */
.page {
  min-height: 100vh;
  background-color: #F5F7FB;
}

.page-body {
  padding: 24rpx 24rpx 40rpx;
}

.tabbar-holder {
  height: 130rpx;
}

/* ---------- 通用工具类 ---------- */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.items-center {
  align-items: center;
}

.t1 {
  color: #1A1D26;
}

.t2 {
  color: #5A6472;
}

.t3 {
  color: #9AA1AC;
}

.primary {
  color: #3D6EF7;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(24, 43, 92, 0.05);
}

.card-tight {
  padding: 8rpx 32rpx;
}

.card-flat {
  box-shadow: none;
  border: 2rpx solid #EEF1F6;
}

/* ---------- 区块标题 ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 8rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D26;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #3D6EF7, #7BA0FF);
}

.section-more {
  font-size: 26rpx;
  color: #9AA1AC;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3D6EF7, #5B8DFF);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(61, 110, 247, 0.28);
}

.btn-primary.btn-disabled {
  background: #C6D0E2;
  color: #FFFFFF;
  box-shadow: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #3D6EF7;
  border: 2rpx solid #C9D8FF;
}

.btn-plain {
  background: #F2F4F8;
  color: #5A6472;
}

.btn-danger-ghost {
  background: #FFFFFF;
  color: #F04438;
  border: 2rpx solid #FFD5D2;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1;
}

.tag-blue {
  background: #EAF0FF;
  color: #3D6EF7;
}

.tag-green {
  background: #E6F7EF;
  color: #16B364;
}

.tag-orange {
  background: #FFF4E5;
  color: #F79009;
}

.tag-red {
  background: #FFEDEC;
  color: #F04438;
}

.tag-gray {
  background: #F2F4F8;
  color: #8A94A6;
}

/* ---------- 头像 ---------- */
.avatar {
  border-radius: 50%;
  background: linear-gradient(135deg, #6E9BFF, #3D6EF7);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
}

.avatar-md {
  width: 88rpx;
  height: 88rpx;
  font-size: 32rpx;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
  font-size: 46rpx;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 2rpx;
  background: #EEF1F6;
  margin: 24rpx 0;
}

.divider-inset {
  height: 2rpx;
  background: #EEF1F6;
}

/* ---------- 列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 20rpx 0;
}

.list-row + .list-row {
  border-top: 2rpx solid #F2F4F8;
}

.list-row-label {
  font-size: 28rpx;
  color: #5A6472;
  width: 160rpx;
  flex-shrink: 0;
}

.list-row-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1D26;
  text-align: right;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #C4CAD6;
  border-right: 3rpx solid #C4CAD6;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F2F4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #C4CAD6;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9AA1AC;
}

/* ---------- 安全区 ---------- */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(24, 43, 92, 0.06);
  display: flex;
  z-index: 20;
}

.fixed-bottom-bar .btn + .btn {
  margin-left: 20rpx;
}

/* ---------- 动效 ---------- */
.fade-in {
  animation: fadeIn 0.28s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- 通用列表项（审批 / 公告 / 通讯录共用） ---------- */
.card-hover {
  opacity: 0.86;
}

.row-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  min-height: 112rpx;
}

.row-item + .row-item {
  border-top: 2rpx solid #F2F4F8;
}

.row-item-hover {
  background: #FAFBFD;
}

.row-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1D26;
}

.row-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9AA1AC;
}

.row-flag {
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* ---------- 轻量空状态 ---------- */
.empty-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
}

.empty-mini-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E6F7EF;
  color: #16B364;
  font-size: 44rpx;
  line-height: 88rpx;
  text-align: center;
  margin-bottom: 18rpx;
}

.empty-mini-text {
  font-size: 26rpx;
  color: #9AA1AC;
  text-align: center;
}
