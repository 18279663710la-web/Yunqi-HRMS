<view class="detail-page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state" bindtap="retry">{{error}}，点击重试</view>
  <block wx:elif="{{document}}">
    <view class="header-card">
      <view class="doc-head">
        <text class="doc-no">{{document.docNo}}</text>
        <text class="doc-customer">{{document.customer || '未填写客户'}}</text>
      </view>
      <view class="field-grid">
        <view class="field"><text class="field-label">立账日期</text><text class="field-value">{{document.businessDate || '-'}}</text></view>
        <view class="field"><text class="field-label">记账期间</text><text class="field-value">{{document.postPeriod || '-'}}</text></view>
        <view class="field"><text class="field-label">来源组织</text><text class="field-value">{{document.srcOrg || '-'}}</text></view>
        <view class="field"><text class="field-label">发票日期</text><text class="field-value">{{document.invoiceDate || '-'}}</text></view>
        <view class="field field-wide"><text class="field-label">发票号</text><text class="field-value">{{document.invoiceNum || '-'}}</text></view>
      </view>
    </view>

    <view class="section-title">明细</view>
    <scroll-view class="table-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="table">
        <view class="table-row table-head">
          <text class="cell col-line">行号</text>
          <text class="cell col-item">料品</text>
          <text class="cell col-code">料号</text>
          <text class="cell col-uom">主单位</text>
          <text class="cell col-qty">数量</text>
          <text class="cell col-price">未税单价</text>
          <text class="cell col-taxprice">含税单价</text>
          <text class="cell col-nontax">未税金额</text>
          <text class="cell col-tax">税额</text>
          <text class="cell col-total">价税合计</text>
          <text class="cell col-fctotal">总金额</text>
          <text class="cell col-balance">总金额余额</text>
          <text class="cell col-status">状态</text>
          <text class="cell col-org">业务组织</text>
          <text class="cell col-maturity">到期日</text>
        </view>
        <view wx:for="{{document.lines}}" wx:key="lineNum" class="table-row">
          <text class="cell col-line">{{item.lineNum}}</text>
          <text class="cell col-item">{{item.itemName}}</text>
          <text class="cell col-code">{{item.itemCode}}</text>
          <text class="cell col-uom">{{item.uom}}</text>
          <text class="cell col-qty">{{item.qty}}</text>
          <text class="cell col-price">{{item.nonTaxPrice}}</text>
          <text class="cell col-taxprice">{{item.taxPrice}}</text>
          <text class="cell col-nontax">{{item.nonTaxAmount}}</text>
          <text class="cell col-tax">{{item.taxAmount}}</text>
          <text class="cell col-total">{{item.taxIncludedTotal}}</text>
          <text class="cell col-fctotal">{{item.totalAmount}}</text>
          <text class="cell col-balance">{{item.totalBalance}}</text>
          <text class="cell col-status">{{item.lineStatus}}</text>
          <text class="cell col-org">{{item.bizOrg}}</text>
          <text class="cell col-maturity">{{item.maturity || '-'}}</text>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{document.lines.length === 0}}" class="state">暂无明细</view>
    <button class="primary-button" loading="{{opening}}" disabled="{{opening}}" bindtap="download">下载 PDF</button>
  </block>
</view>
