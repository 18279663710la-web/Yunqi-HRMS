page { background: #f5f7fb; color: #1d2940; }
.detail-page { padding: 24rpx 24rpx 150rpx; }
.state { text-align: center; color: #9aa5b5; font-size: 26rpx; padding: 80rpx 20rpx; }
.header-card { background: #fff; border-radius: 22rpx; padding: 28rpx; box-shadow: 0 6rpx 20rpx rgba(38, 59, 104, .04); margin-bottom: 24rpx; }
.doc-head { display: flex; flex-direction: column; gap: 10rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eef2f8; }
.doc-no { font-size: 32rpx; font-weight: 600; }
.doc-customer { font-size: 27rpx; color: #536179; }
.field-grid { display: flex; flex-wrap: wrap; margin: 16rpx -10rpx 0; }
.field { display: flex; flex-direction: column; width: 50%; box-sizing: border-box; padding: 0 10rpx 16rpx; min-width: 0; }
.field-wide { width: 100%; }
.field-label { color: #929eae; font-size: 22rpx; line-height: 32rpx; }
.field-value { color: #536179; font-size: 25rpx; line-height: 36rpx; word-break: break-all; }
.section-title { font-size: 26rpx; font-weight: 600; margin: 8rpx 4rpx 14rpx; }
.table-scroll { width: 100%; background: #fff; border-radius: 16rpx; margin-bottom: 24rpx; box-shadow: 0 6rpx 20rpx rgba(38, 59, 104, .04); }
.table { width: 2100rpx; }
.table-row { display: flex; align-items: stretch; border-bottom: 1rpx solid #eef2f8; }
.table-row:last-child { border-bottom: 0; }
.table-head { background: #edf1f7; }
.cell { display: block; flex: none; box-sizing: border-box; padding: 16rpx 12rpx; font-size: 22rpx; line-height: 32rpx; color: #536179; border-right: 1rpx solid #eef2f8; word-break: break-all; white-space: normal; }
.table-head .cell { color: #27364e; font-weight: 600; }
.table-row .cell:last-child { border-right: 0; }
.col-line { width: 70rpx; text-align: center; }
.col-item { width: 220rpx; }
.col-code { width: 150rpx; }
.col-uom { width: 90rpx; text-align: center; }
.col-qty { width: 110rpx; text-align: right; }
.col-price { width: 140rpx; text-align: right; }
.col-taxprice { width: 140rpx; text-align: right; }
.col-nontax { width: 150rpx; text-align: right; }
.col-tax { width: 130rpx; text-align: right; }
.col-total { width: 150rpx; text-align: right; }
.col-fctotal { width: 140rpx; text-align: right; }
.col-balance { width: 160rpx; text-align: right; }
.col-status { width: 90rpx; text-align: center; }
.col-org { width: 240rpx; }
.col-maturity { width: 120rpx; text-align: center; }
.primary-button { background: #486df3; color: #fff; border-radius: 14rpx; font-size: 28rpx; margin-top: 8rpx; }
