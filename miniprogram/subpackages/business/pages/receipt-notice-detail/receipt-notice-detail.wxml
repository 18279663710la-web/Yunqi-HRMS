<view class="detail-page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state" bindtap="retry">{{error}}，点击重试</view>
  <block wx:elif="{{detail}}">
    <view class="mail-card">
      <view class="mail-title">您的客户 {{detail.customerName}} 已回款</view>
      <view class="mail-copy">
        <view class="mail-line">您好！</view>
        <view class="mail-line"><text class="strong">{{detail.customerName}}</text><text> 的回款：</text></view>
        <view class="mail-line">单号{{detail.docNo}}，财务已经入账。</view>
        <view class="mail-line strong"><text>收款日期</text><text class="mail-value">{{detail.businessDate}}</text></view>
        <view class="mail-line strong"><text>总金额</text><text class="mail-value">{{detail.totalAmount}} 元</text></view>
        <view class="mail-line">以下是明细信息：</view>
      </view>
      <view class="table">
        <view class="tr th">
          <text class="td col-line">行号</text>
          <text class="td col-method">结算方式</text>
          <text class="td col-note">流水号</text>
          <text class="td col-amount">金额(元)</text>
          <text class="td col-bank">银行账号</text>
        </view>
        <view wx:for="{{detail.lines}}" wx:key="lineNum" class="tr">
          <text class="td col-line">{{item.lineNum}}</text>
          <text class="td col-method">{{item.settlementMethod}}</text>
          <text class="td col-note">{{item.noteNo}}</text>
          <text class="td col-amount">{{item.amount}}</text>
          <text class="td col-bank">{{item.bankAccount}}</text>
        </view>
      </view>
      <view class="mail-note">（注：请以单号、流水号为准。如有疑问，请联系财务人员处理。）</view>
    </view>
    <view class="mail-footer">本消息由云枢办公自动推送，企业账套：{{detail.orgName}}</view>
  </block>
</view>
