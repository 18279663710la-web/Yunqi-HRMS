[Unit]
Description=Yunqi Office API
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
# 按实际部署路径与运行用户修改
WorkingDirectory=/srv/yunqi/server
EnvironmentFile=/srv/yunqi/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
User=yunqi
Group=yunqi
# 日志进入 journald，按服务名过滤：journalctl -u yunqi-office -f
SyslogIdentifier=yunqi-office
StandardOutput=journal
StandardError=journal
# 生产环境必须使用真实 JWT_SECRET，服务端会拒绝开发默认值

[Install]
WantedBy=multi-user.target
