# 小程序 API 入口（公网 HTTPS）
#
# 使用前提：
#   1. 域名已完成 ICP 备案（大陆服务器）；
#   2. api.example.com 的 A 记录指向本机公网 IP；
#   3. 已放置受信任的 HTTPS 证书（Let's Encrypt 或云证书，不能用自签名）；
#   4. 服务器防火墙放行 443，3100/3306/8080 不对公网开放。
#
# 启用方式：把本文件改名为 miniprogram.conf（去掉 .template 后缀）后执行 nginx -t && systemctl reload nginx。
# 未改名时不会被 nginx 加载，避免证书缺失导致 nginx 启动失败。
#
# 微信后台需配置：
#   开发管理 → 开发设置 → 服务器域名：request / uploadFile / downloadFile 填 https://api.example.com
#   开发管理 → 接口设置：申请 getLocation（考勤打卡、拜访签到）
#   用户隐私保护指引：声明位置、相册/摄像头、选中的文件

server {
    listen 443 ssl http2;
    server_name api.example.com;

    ssl_certificate     C:/yunqi/nginx/ssl/api.example.com/fullchain.pem;
    ssl_certificate_key C:/yunqi/nginx/ssl/api.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 32m;

    # 小程序启动会探测 https://域名/health，必须代理，否则真机判定后端不可用
    location = /health {
        proxy_pass http://127.0.0.1:3100/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 所有员工端与管理端 API；报销原图签名地址也在 /api/approval-files 下，由 Express 鉴权
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 不要静态直出 /uploads：合同、模板等文件需要 Express 鉴权，报销原图使用短期签名地址。
}

# HTTP 跳 HTTPS
server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}
