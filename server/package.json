{
  "name": "yunqi-office-server",
  "version": "1.0.0",
  "private": true,
  "description": "云启科技 · 企业办公小程序后端（Node.js + TypeScript + Express + MySQL）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "tsx src/shared/db/setup.ts",
    "db:reset": "tsx src/shared/db/setup.ts --reset",
    "smoke": "node scripts/smoke.mjs",
    "smoke:admin": "node scripts/admin-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "msnodesqlv8": "^5.6.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "pdfkit": "^0.17.2",
    "pinyin-pro": "^3.29.5",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.332",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "^11.1.1"
    }
  }
}
