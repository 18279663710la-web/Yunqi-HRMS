PORT=3100
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=yunqi_office
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d
AUTO_MIGRATE=true
OCR_DRIVER=mock
VERIFY_DRIVER=tencent
# 报销 AI 建议：密钥只放在本地环境文件，不提交到仓库
EXPENSE_AI_DRIVER=deepseek
DEEPSEEK_API_KEY=
EXPENSE_AI_BASE_URL=https://api.deepseek.com
EXPENSE_AI_MODEL=deepseek-flash
# 流程节点凭据加密密钥（可选 64 位十六进制；留空时使用首次保存生成的本地密钥）
WORKFLOW_CREDENTIAL_KEY=
# 可选：自动生成的流程节点凭据密钥文件位置，留空使用服务端运行时目录
WORKFLOW_CREDENTIAL_KEY_FILE=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
# 腾讯位置服务 WebServiceAPI Key：用于拜访地址逆解析；需开启 WebServiceAPI 并分配逆地址解析额度，未配置时显示“当前位置”
TENCENT_MAP_KEY=
# U9 回款通知轮询：只处理 U9“收款单审核发送”规则中的组织；首次启动写入起点，留空使用当天
U9_RECEIPT_NOTIFY_ORG_CODE=001
# U9_RECEIPT_NOTIFY_SINCE=2026-11-01
U9_RECEIPT_NOTIFY_LOOKBACK_DAYS=2
U9_RECEIPT_NOTIFY_POLL_MS=60000
# U9 只读镜像（本机对照通过后员工查询读 MySQL；回滚改 U9_QUERY_SOURCE=sqlserver）
# 首次空库可先 sqlserver，跑通 ETL/parity 后再改为 mysql
U9_QUERY_SOURCE=mysql
U9_ETL_ENABLED=true
U9_SQL_SERVER=.
U9_SQL_DATABASE=U9数据库
# 部署全量起点；留空则自动取 U9 应收/收款最早业务日。夜间校对同此范围。
# U9_ETL_FULL_SINCE=
# 启动时若尚无成功同步则自动全量；已有同步后只跑增量+夜间全量校对
U9_ETL_BOOTSTRAP_ON_START=true
# U9_ETL_INCREMENTAL_MS=3600000
# U9_ETL_NIGHTLY_HOUR=2
# U9_ETL_SKIP_HOURS=9,10,11
# U9_ETL_BATCH_SIZE=200
# U9_ETL_IN_CHUNK=100
# U9_QUERY_CACHE_TTL_MS=120000
# U9_ETL_LOOKBACK_DAYS=3
# 业务模块维护窗（本地小时，半开区间 start<=hour<end）；此间 /api/business 返回 503
# U9_BUSINESS_MAINTENANCE_START_HOUR=0
# U9_BUSINESS_MAINTENANCE_END_HOUR=2
UPLOAD_DIR=uploads
CORS_ORIGIN=*

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=系统管理员

# 种子员工的小程序登录密码（登录名见 README）
DEMO_EMPLOYEE_PASSWORD=Yunqi@123456
